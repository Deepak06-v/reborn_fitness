# REBORN FITNESS admin API — environment variables (placeholders only)
# Copy to server/.env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# MongoDB connection string (local or hosted, e.g. MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/reborn_fitness

# 32+ byte random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# Comma-separated list of allowed frontend origins for credentialed CORS.
# In same-origin/proxied deployments this can be the single app origin.
CORS_ORIGINS=http://localhost:5173

# Set to "true" when serving over HTTPS so session cookies are Secure.
COOKIE_SECURE=false

# Session lifetime in hours
SESSION_TTL_HOURS=8

# How often the recurring-billing reconciliation job runs, in minutes.
# Reconciliation is also triggered on admin reads, so this only sets the
# background safety net. Defaults to 360 (6 hours) when unset.
# BILLING_RECONCILE_INTERVAL_MINUTES=360

# --- Admin bootstrap (automatic on startup) ---
# The admin account is created automatically the first time the server starts
# with these set, then left unchanged on every later start (the password is
# never reset). Required in production; optional for local development.
# The account is always created with role "superadmin" and active "true".
# ADMIN_USERNAME=owner
# ADMIN_PASSWORD=choose-a-strong-password-min-12-chars

# --- Meta WhatsApp Business Platform Cloud API ---
# Provider: mock (for dev/tests) or cloud_api (for Meta official Cloud API)
WHATSAPP_PROVIDER=cloud_api
# Keep false until credentials, webhook verification, and templates are verified!
WHATSAPP_ENABLED=false

# Meta Graph API version (must be a supported version, e.g. v21.0)
WHATSAPP_GRAPH_API_VERSION=v21.0

# Meta Cloud API Credentials (obtain from Meta Developer Portal / Business Manager)
# System User Access Token with 'whatsapp_business_messaging' and 'whatsapp_business_management' permissions
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
# WhatsApp Phone Number ID (from WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-business-account-id
# Meta App Secret (from App settings > Basic, used to verify HMAC-SHA256 webhook signatures)
WHATSAPP_APP_SECRET=your-meta-app-secret

# Webhook Verification Token (custom string configured in Meta Developer Portal webhook setup)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token
# Relative endpoint path for the Meta Webhook
WHATSAPP_WEBHOOK_PATH=/api/whatsapp/webhook

# --- Meta Approved Message Templates ---
# Templates must be submitted and approved in Meta WhatsApp Manager before use.
# Variable names and language codes must match exactly.
WHATSAPP_TEMPLATE_FEE_DUE=reborn_fee_due_reminder
WHATSAPP_TEMPLATE_FEE_DUE_LANG=en_US
WHATSAPP_TEMPLATE_FEE_OVERDUE=reborn_fee_overdue_reminder
WHATSAPP_TEMPLATE_FEE_OVERDUE_LANG=en_US
WHATSAPP_TEMPLATE_GYM_CLOSURE=reborn_gym_closure
WHATSAPP_TEMPLATE_GYM_CLOSURE_LANG=en_US
WHATSAPP_TEMPLATE_FESTIVE_OFFER=reborn_festive_offer
WHATSAPP_TEMPLATE_FESTIVE_OFFER_LANG=en_US

# --- Controlled Outbound Messaging & Queue Settings ---
# Sequential queue batching and cooldown
WHATSAPP_QUEUE_BATCH_SIZE=5
WHATSAPP_QUEUE_BATCH_COOLDOWN_MS=5000
WHATSAPP_MESSAGE_DELAY_MS=1500

# Rolling-window rate limiter settings (enforce cap well below Meta Tier 1 limits, e.g. 15 msgs / 60s)
WHATSAPP_RATE_LIMIT_MAX_PER_WINDOW=15
WHATSAPP_RATE_LIMIT_WINDOW_MS=60000
WHATSAPP_MAX_RETRIES=3

# Campaign pacing, configured in milliseconds (default: 4000)
WHATSAPP_CAMPAIGN_DELAY_MS=4000
